{% comment %} Fusion Nav {% endcomment %}
<div class="w-screen">
  <div class="bg-[#0f2719] py-5 w-full flex justify-center items-center">
    <h1 class="uppercase text-white text-2xl md:text-5xl font-medium">
      A fusion of flavours!
    </h1>
  </div>

  <div class="flex bg-[#ffb045] py-3">
    <nav class="flex justify-center items-center mx-auto space-x-5 md:space-x-10 font-bold tracking-wide md:px-0 px-8">
      {% for link in linklists.fusion-menu.links %}
        <div class="relative py-1">
          <a href="{{ link.url }}" class="uppercase text-sm font-md text-gray-900 hover:text-gray-500 hover:underline hover:underline-offset-4">{{ link.title }}</a>
        </div>
      {% endfor %}
    </nav>
  </div>
</div>

{% render 'recipe-blog-list',
  eyebrow: section.settings.eyebrow,
  subheading: section.settings.subheading,
  posts_per_page: section.settings.posts_per_page,
  read_more_text: section.settings.read_more_text,
  empty_message: section.settings.empty_message
%}

{% schema %}
{
  "name": "Recipe Blog",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text",
      "default": "Cook with GG's"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Caribbean-inspired recipes using our sauces and marinades"
    },
    {
      "type": "range",
      "id": "posts_per_page",
      "label": "Recipes per page",
      "min": 3,
      "max": 12,
      "step": 1,
      "default": 6
    },
    {
      "type": "text",
      "id": "read_more_text",
      "label": "Read more label",
      "default": "Read full recipe"
    },
    {
      "type": "text",
      "id": "empty_message",
      "label": "Empty state message",
      "default": "No recipes published yet."
    }
  ]
}
{% endschema %}
